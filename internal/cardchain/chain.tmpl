{{define "pill"}}<span class="slot{{if .Off}} off{{end}}"><span class="slotno">{{.Slot}}</span><span class="name">{{.Label}}</span></span>{{end}}<div class="chain">{{range $i, $s := .Steps}}{{if $i}}<span class="arrow">→</span>{{end}}{{if $s.Branches}}<span class="mark" aria-hidden="true">╫</span><span class="par">{{range $s.Branches}}<span class="branch">{{if .Label}}<span class="parlabel">{{.Label}}</span>{{end}}{{range $j, $st := .Steps}}{{if $j}}<span class="arrow">→</span>{{end}}{{template "pill" $st}}{{end}}</span>{{end}}</span><span class="mark" aria-hidden="true">╫</span>{{else}}{{template "pill" $s}}{{end}}{{end}}</div>
